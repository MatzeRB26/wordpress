# Copy this file to .env and replace all placeholder values.
# Never commit the .env file!

# --- Database (db service) ---
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_USER=change-me-db-user
MARIADB_PASSWORD=change-me-db-password

# --- WordPress (wordpress service) ---
# Must match MARIADB_USER / MARIADB_PASSWORD above
WORDPRESS_DB_USER=change-me-db-user
WORDPRESS_DB_PASSWORD=change-me-db-password
